toolframe(3)
modserv = modbus_server()

-- 기존 레지스터 그대로 사용:
-- 'x' (301), 'y' (302), 'z' (303), 'Rx' (304), 'Ry' (305), 'Rz' (306)
-- 'x2' (307), 'y2' (308), 'z2' (309), 'Rx2' (310), 'Ry2' (311), 'Rz2' (312)
-- 'task_number' (351) -> command
-- 'task_done' (352) -> status
-- 상태 코드: 0=Idle, 1=Running, 2=Done, 3=Error

modserv.write_register('task_done', 0)

while true do
    command = modserv.read_register('task_number')

    if command == 1 then
        modserv.write_register('task_done', 1)
        movep(var.p(100))
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 2 then
        modserv.write_register('task_done', 1)
        modserv.write_register('task_done', 3)
        modserv.write_register('task_number', 0)

    elseif command == 10 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        if  x>32767  then
            x= x-65537
        end
        tool.transx(x)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 11 then
        modserv.write_register('task_done', 1)
        y = modserv.read_register('y')
        if  y>32767  then
            y= y-65537
        end
        tool.transy(y)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 12 then
        modserv.write_register('task_done', 1)
        z = modserv.read_register('z')
        if  z>32767  then
            z= z-65537
        end
        tool.transz(z)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 13 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        if  x>32767  then
            x= x-65537
        end
        if  y>32767  then
            y= y-65537
        end
        if  z>32767  then
            z= z-65537
        end
        tool.trans(x, y, z)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    -- command 14-17: 회전 명령 (tool.rot() 미지원으로 비활성화)
    -- 회전이 필요한 경우 command 20 (절대 위치 이동) 사용

    elseif command == 20 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        Rx = modserv.read_register('Rx')
        Ry = modserv.read_register('Ry')
        Rz = modserv.read_register('Rz')
        if  x>32767  then
            x= x-65537
        end
        if  y>32767  then
            y= y-65537
        end
        if  z>32767  then
            z= z-65537
        end
        if  Rx>32767  then
            Rx= Rx-65537
        end
        if  Ry>32767  then
            Ry= Ry-65537
        end
        if  Rz>32767  then
            Rz= Rz-65537
        end
        p1 = pose(x/10, y/10, z/10, Rx/10, Ry/10, Rz/10)
        movel(p1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 30 then
        modserv.write_register('task_done', 1)
        dio.set(10)
        delay(2500)
        dio.reset(10)
        dio.reset(7)
        dio.set(8)
        dio.set(2)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(4)
        dio.reset(2)
        dio.in_wait(2, 1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 31 then
        modserv.write_register('task_done', 1)
        dio.set(1)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(1)
        dio.reset(4)
        dio.in_wait(1,1)
        delay(2300)
        dio.set(9)
        delay(2500)
        dio.reset(9)
        dio.set(7)
        dio.reset(8)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 32 then
        modserv.write_register('task_done', 1)
        dio.pulse(5, 1, 30)
        dio.in_wait(8,1)
        dio.set(6)
        delay(20)
        dio.pulse(3, 1, 30)
        delay(500)
        dio.in_wait(5,1)
        dio.set(10)
        delay(2500)
        dio.reset(10)
        dio.reset(7)
        dio.set(8)
        dio.set(2)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(4)
        dio.reset(2)
        dio.in_wait(2, 1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    -- command 40-43: 툴프레임 변경
    elseif command == 40 then
        modserv.write_register('task_done', 1)
        toolframe(0)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 41 then
        modserv.write_register('task_done', 1)
        toolframe(1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 42 then
        modserv.write_register('task_done', 1)
        toolframe(2)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)

    elseif command == 43 then
        modserv.write_register('task_done', 1)
        toolframe(3)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
    end

    delay(100)
end
