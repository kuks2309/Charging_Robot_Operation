toolframe(3)
modserv = modbus_server()

-- 기존 레지스터 그대로 사용:
-- 'x' (301), 'y' (302), 'z' (303), 'Rx' (304), 'Ry' (305), 'Rz' (306)
-- 'x2' (307), 'y2' (308), 'z2' (309), 'Rx2' (310), 'Ry2' (311), 'Rz2' (312)
-- 'task_number' (351) -> command
-- 'task_done' (352) -> status
-- 상태 코드: 0=Idle, 1=Running, 2=Done, 3=Error
-- 모든 이송(translation) 명령: ×10 스케일, 0.1mm 단위 (CMD 10-13, 50-53, 60-63)

modserv.write_register('task_done', 0)

while true do
    command = modserv.read_register('task_number')

    if command == 1 then
        modserv.write_register('task_done', 1)
        movep(var.p(100))
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 2 then
        modserv.write_register('task_done', 1)
        modserv.write_register('task_done', 3)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 10 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        if  x>32767  then
            x= x-65536
        end
        tool.transx(x/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 11 then
        modserv.write_register('task_done', 1)
        y = modserv.read_register('y')
        if  y>32767  then
            y= y-65536
        end
        tool.transy(y/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 12 then
        modserv.write_register('task_done', 1)
        z = modserv.read_register('z')
        if  z>32767  then
            z= z-65536
        end
        tool.transz(z/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 13 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        if  x>32767  then
            x= x-65536
        end
        if  y>32767  then
            y= y-65536
        end
        if  z>32767  then
            z= z-65536
        end
        tool.trans(x/10, y/10, z/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 14-16: 툴 좌표계 회전 (tool.rotx/y/z)
    elseif command == 14 then
        modserv.write_register('task_done', 1)
        Rx = modserv.read_register('Rx')
        if Rx > 32767 then
            Rx = Rx - 65536
        end
        tool.rotx(Rx/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 15 then
        modserv.write_register('task_done', 1)
        Ry = modserv.read_register('Ry')
        if Ry > 32767 then
            Ry = Ry - 65536
        end
        tool.roty(Ry/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 16 then
        modserv.write_register('task_done', 1)
        Rz = modserv.read_register('Rz')
        if Rz > 32767 then
            Rz = Rz - 65536
        end
        tool.rotz(Rz/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 17: 툴 좌표계 회전 RxRyRz (×10 스케일, 0.1° 단위)
    elseif command == 17 then
        modserv.write_register('task_done', 1)
        Rx = modserv.read_register('Rx')
        Ry = modserv.read_register('Ry')
        Rz = modserv.read_register('Rz')
        if Rx > 32767 then
            Rx = Rx - 65536
        end
        if Ry > 32767 then
            Ry = Ry - 65536
        end
        if Rz > 32767 then
            Rz = Rz - 65536
        end
        tool.rotx(Rx/10)
        tool.roty(Ry/10)
        tool.rotz(Rz/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 20 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        Rx = modserv.read_register('Rx')
        Ry = modserv.read_register('Ry')
        Rz = modserv.read_register('Rz')
        if  x>32767  then
            x= x-65536
        end
        if  y>32767  then
            y= y-65536
        end
        if  z>32767  then
            z= z-65536
        end
        if  Rx>32767  then
            Rx= Rx-65536
        end
        if  Ry>32767  then
            Ry= Ry-65536
        end
        if  Rz>32767  then
            Rz= Rz-65536
        end
        -- Euler 각도 ±180° 정규화 (÷10 후 적용, movel 범위 초과 방지)
        rx_deg = Rx/10
        ry_deg = Ry/10
        rz_deg = Rz/10
        while rx_deg > 180 do
            rx_deg = rx_deg - 360
        end
        while rx_deg < -180 do
            rx_deg = rx_deg + 360
        end
        while ry_deg > 180 do
            ry_deg = ry_deg - 360
        end
        while ry_deg < -180 do
            ry_deg = ry_deg + 360
        end
        while rz_deg > 180 do
            rz_deg = rz_deg - 360
        end
        while rz_deg < -180 do
            rz_deg = rz_deg + 360
        end
        p1 = pose(x/10, y/10, z/10, rx_deg, ry_deg, rz_deg)
        movel(p1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 30 then
        modserv.write_register('task_done', 1)
        dio.set(10)
        delay(2500)
        dio.reset(10)
        dio.reset(7)
        dio.set(8)
        dio.set(2)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(4)
        dio.reset(2)
        dio.in_wait(2, 1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 31 then
        modserv.write_register('task_done', 1)
        dio.set(1)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(1)
        dio.reset(4)
        dio.in_wait(1,1)
        delay(2300)
        dio.set(9)
        delay(2500)
        dio.reset(9)
        dio.set(7)
        dio.reset(8)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 32 then
        modserv.write_register('task_done', 1)
        dio.pulse(5, 1, 30)
        dio.in_wait(8,1)
        dio.set(6)
        delay(20)
        dio.pulse(3, 1, 30)
        delay(500)
        dio.in_wait(5,1)
        dio.set(10)
        delay(2500)
        dio.reset(10)
        dio.reset(7)
        dio.set(8)
        dio.set(2)
        delay(20)
        dio.set(4)
        delay(20)
        dio.reset(4)
        dio.reset(2)
        dio.in_wait(2, 1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 41-43, 45-46: 툴프레임 변경 (TF1-TF5)
    -- command 40 (TF0)은 Eye-in-Hand 전용으로 제거됨
    elseif command == 41 then
        modserv.write_register('task_done', 1)
        toolframe(1)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 42 then
        modserv.write_register('task_done', 1)
        toolframe(2)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 43 then
        modserv.write_register('task_done', 1)
        toolframe(3)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 45 then
        modserv.write_register('task_done', 1)
        toolframe(4)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 46 then
        modserv.write_register('task_done', 1)
        toolframe(5)  -- TF5: Hand-Eye Calibration 결과
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 44: 워크프레임 0으로 변경
    elseif command == 44 then
        modserv.write_register('task_done', 1)
        workframe(0)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 50-53: 베이스 좌표계 이동 (transx, transy, transz, trans)
    elseif command == 50 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        if x > 32767 then
            x = x - 65536
        end
        transx(x/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 51 then
        modserv.write_register('task_done', 1)
        y = modserv.read_register('y')
        if y > 32767 then
            y = y - 65536
        end
        transy(y/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 52 then
        modserv.write_register('task_done', 1)
        z = modserv.read_register('z')
        if z > 32767 then
            z = z - 65536
        end
        transz(z/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 53 then
        modserv.write_register('task_done', 1)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        if x > 32767 then
            x = x - 65536
        end
        if y > 32767 then
            y = y - 65536
        end
        if z > 32767 then
            z = z - 65536
        end
        trans(x/10, y/10, z/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 54-56: 베이스 좌표계 회전 (rotx, roty, rotz) (×10 스케일, 0.1° 단위)
    -- CMD 54-56은 증분(delta) 회전 명령이므로 ±180° 정규화 불필요
    -- Python send_base_rotate()에서 경계 교차 감지 후 이 명령으로 전환됨 (CMD 20 movel 대신)
    -- 정규화를 추가하면 증분 delta의 방향이 변경되어 유해함. CMD 20 while-loop 참조
    elseif command == 54 then
        modserv.write_register('task_done', 1)
        Rx = modserv.read_register('Rx')
        if Rx > 32767 then
            Rx = Rx - 65536
        end
        rotx(Rx/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 55 then
        modserv.write_register('task_done', 1)
        Ry = modserv.read_register('Ry')
        if Ry > 32767 then
            Ry = Ry - 65536
        end
        roty(Ry/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 56 then
        modserv.write_register('task_done', 1)
        Rz = modserv.read_register('Rz')
        if Rz > 32767 then
            Rz = Rz - 65536
        end
        rotz(Rz/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    -- command 60-63: DEPRECATED - CMD 50-53이 0.1mm 지원으로 대체. 하위호환을 위해 유지
    elseif command == 60 then
        modserv.write_register('task_done', 1)
        fx = modserv.read_register('x2')
        if fx > 32767 then
            fx = fx - 65536
        end
        transx(fx/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 61 then
        modserv.write_register('task_done', 1)
        fy = modserv.read_register('y2')
        if fy > 32767 then
            fy = fy - 65536
        end
        transy(fy/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 62 then
        modserv.write_register('task_done', 1)
        fz = modserv.read_register('z2')
        if fz > 32767 then
            fz = fz - 65536
        end
        transz(fz/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)

    elseif command == 63 then
        modserv.write_register('task_done', 1)
        fx = modserv.read_register('x2')
        fy = modserv.read_register('y2')
        fz = modserv.read_register('z2')
        if fx > 32767 then
            fx = fx - 65536
        end
        if fy > 32767 then
            fy = fy - 65536
        end
        if fz > 32767 then
            fz = fz - 65536
        end
        trans(fx/10, fy/10, fz/10)
        modserv.write_register('task_done', 2)
        modserv.write_register('task_number', 0)
        modserv.write_register('task_done', 0)
    end

    delay(50)
end
