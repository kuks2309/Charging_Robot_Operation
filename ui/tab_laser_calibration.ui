          <!-- 캘리브레이션 설정 -->
          <item>
           <widget class="QGroupBox" name="groupCalibSettings">
            <property name="title">
             <string>캘리브레이션 설정</string>
            </property>
            <layout class="QGridLayout" name="gridLayoutCalibSettings">
             <property name="horizontalSpacing"><number>6</number></property>
             <property name="verticalSpacing"><number>4</number></property>
             <property name="leftMargin"><number>6</number></property>
             <property name="topMargin"><number>6</number></property>
             <property name="rightMargin"><number>6</number></property>
             <property name="bottomMargin"><number>6</number></property>
             <item row="0" column="0">
              <widget class="QLabel" name="labelTargetYLabel">
               <property name="text"><string>마커 중심 Y 오프셋:</string></property>
               <property name="toolTip"><string>ArUco 마커 중심으로부터 레이저 목표까지의 수직 오프셋 (양수=아래)</string></property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QSpinBox" name="spinTargetLaserY">
               <property name="suffix"><string> px</string></property>
               <property name="minimum"><number>0</number></property>
               <property name="maximum"><number>500</number></property>
               <property name="value"><number>190</number></property>
               <property name="toolTip"><string>ArUco 마커 중심 Y + 이 값 = 레이저 목표 Y (양수=아래)</string></property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="labelXStepLabel">
               <property name="text"><string>X 이동 스텝:</string></property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="spinXMoveStep">
               <property name="suffix"><string> mm</string></property>
               <property name="decimals"><number>1</number></property>
               <property name="minimum"><double>1.000000000000000</double></property>
               <property name="maximum"><double>50.000000000000000</double></property>
               <property name="value"><double>10.000000000000000</double></property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="labelRepeatCountLabel">
               <property name="text"><string>반복 횟수:</string></property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QSpinBox" name="spinRepeatCount">
               <property name="minimum"><number>2</number></property>
               <property name="maximum"><number>20</number></property>
               <property name="value"><number>5</number></property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>

          <!-- 캘리브레이션 실행 -->
          <item>
           <widget class="QGroupBox" name="groupCalibExec">
            <property name="title">
             <string>캘리브레이션 실행</string>
            </property>
            <layout class="QVBoxLayout" name="verticalLayoutCalibExec">
             <property name="spacing"><number>4</number></property>
             <property name="leftMargin"><number>6</number></property>
             <property name="topMargin"><number>6</number></property>
             <property name="rightMargin"><number>6</number></property>
             <property name="bottomMargin"><number>6</number></property>

             <!-- Step indicator -->
             <item>
              <widget class="QLabel" name="labelCalibStep">
               <property name="text"><string>대기 중</string></property>
               <property name="styleSheet">
                <string>font-weight: bold; color: #555; padding: 2px 4px; background-color: #f0f0f0; border: 1px solid #ccc; border-radius: 3px;</string>
               </property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>

             <!-- Row 1: 1~3 -->
             <item>
              <layout class="QHBoxLayout" name="horizontalLayoutCalibRow1">
               <property name="spacing"><number>3</number></property>
               <item>
                <widget class="QPushButton" name="btnAlignAruco">
                 <property name="text"><string>1. ArUco 정렬</string></property>
                 <property name="styleSheet"><string>QPushButton { padding: 5px 3px; }</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnAdjustZ">
                 <property name="text"><string>2. Z 조정</string></property>
                 <property name="styleSheet"><string>QPushButton { padding: 5px 3px; }</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnSavePosition">
                 <property name="text"><string>3. 위치 저장</string></property>
                 <property name="styleSheet"><string>QPushButton { padding: 5px 3px; }</string></property>
                </widget>
               </item>
              </layout>
             </item>

             <!-- Row 2: 4~5 -->
             <item>
              <layout class="QHBoxLayout" name="horizontalLayoutCalibRow2">
               <property name="spacing"><number>3</number></property>
               <item>
                <widget class="QPushButton" name="btnMoveXAdjustZ">
                 <property name="text"><string>4. X 이동 + Z 재조정</string></property>
                 <property name="styleSheet"><string>QPushButton { padding: 5px 3px; }</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnSaveCompare">
                 <property name="text"><string>5. 비교 저장</string></property>
                 <property name="styleSheet"><string>QPushButton { padding: 5px 3px; }</string></property>
                </widget>
               </item>
              </layout>
             </item>

             <!-- 자동 캘리브레이션 -->
             <item>
              <widget class="QPushButton" name="btnAutoCalib">
               <property name="text"><string>자동 캘리브레이션</string></property>
               <property name="minimumSize"><size><width>0</width><height>36</height></size></property>
               <property name="styleSheet">
                <string>QPushButton {
    padding: 8px;
    font-weight: bold;
    font-size: 14px;
    background-color: #1565C0;
    color: white;
    border-radius: 4px;
}
QPushButton:hover {
    background-color: #1976D2;
}
QPushButton:pressed {
    background-color: #0D47A1;
}
QPushButton:disabled {
    background-color: #90A4AE;
    color: #eceff1;
}</string>
               </property>
              </widget>
             </item>

             <!-- Progress bar -->
             <item>
              <widget class="QProgressBar" name="progressCalib">
               <property name="value"><number>0</number></property>
               <property name="textVisible"><bool>true</bool></property>
               <property name="format"><string>%v / %m</string></property>
              </widget>
             </item>

            </layout>
           </widget>
          </item>

          <!-- 캘리브레이션 데이터 -->
          <item>
           <widget class="QGroupBox" name="groupCalibData">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>1</verstretch>
             </sizepolicy>
