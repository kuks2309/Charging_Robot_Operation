            <property name="title">
             <string>캘리브레이션 설정</string>
            </property>
            <layout class="QGridLayout" name="gridLayoutCalibSettings">
             <property name="horizontalSpacing"><number>6</number></property>
             <property name="verticalSpacing"><number>4</number></property>
             <property name="leftMargin"><number>6</number></property>
             <property name="topMargin"><number>6</number></property>
             <property name="rightMargin"><number>6</number></property>
             <property name="bottomMargin"><number>6</number></property>
             <item row="0" column="0">
              <widget class="QLabel" name="labelTargetYLabel">
               <property name="text"><string>마커 중심 Y 오프셋:</string></property>
               <property name="toolTip"><string>ArUco 마커 중심으로부터 레이저 목표까지의 수직 오프셋 (양수=아래)</string></property>
              </widget>
             </item>
             <item row="0" column="1">
              <widget class="QSpinBox" name="spinTargetLaserY">
               <property name="suffix"><string> px</string></property>
               <property name="minimum"><number>0</number></property>
               <property name="maximum"><number>500</number></property>
               <property name="value"><number>190</number></property>
               <property name="toolTip"><string>ArUco 마커 중심 Y + 이 값 = 레이저 목표 Y (양수=아래)</string></property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QLabel" name="labelXStepLabel">
               <property name="text"><string>X 이동 스텝:</string></property>
              </widget>
             </item>
             <item row="1" column="1">
              <widget class="QDoubleSpinBox" name="spinXMoveStep">
               <property name="suffix"><string> mm</string></property>
               <property name="decimals"><number>1</number></property>
               <property name="minimum"><double>1.000000000000000</double></property>
               <property name="maximum"><double>50.000000000000000</double></property>
               <property name="value"><double>10.000000000000000</double></property>
              </widget>
             </item>
             <item row="2" column="0">
              <widget class="QLabel" name="labelRepeatCountLabel">
               <property name="text"><string>반복 횟수:</string></property>
              </widget>
             </item>
             <item row="2" column="1">
              <widget class="QSpinBox" name="spinRepeatCount">
               <property name="minimum"><number>2</number></property>
               <property name="maximum"><number>20</number></property>
               <property name="value"><number>5</number></property>
              </widget>
             </item>
            </layout>
           </widget>
