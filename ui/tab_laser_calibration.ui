            <property name="title">
             <string>캘리브레이션 데이터</string>
            </property>
            <layout class="QVBoxLayout" name="verticalLayoutCalibData">
             <property name="spacing"><number>4</number></property>
             <property name="leftMargin"><number>4</number></property>
             <property name="topMargin"><number>4</number></property>
             <property name="rightMargin"><number>4</number></property>
             <property name="bottomMargin"><number>4</number></property>

             <item>
              <widget class="QTableWidget" name="tableCalibData">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
               <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
               <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
               <property name="columnCount"><number>7</number></property>
               <column><property name="text"><string>#</string></property></column>
               <column><property name="text"><string>X1(mm)</string></property></column>
               <column><property name="text"><string>Z1(mm)</string></property></column>
               <column><property name="text"><string>X2(mm)</string></property></column>
               <column><property name="text"><string>Z2(mm)</string></property></column>
               <column><property name="text"><string>ΔX(mm)</string></property></column>
               <column><property name="text"><string>ΔZ(mm)</string></property></column>
              </widget>
             </item>

             <item>
              <layout class="QHBoxLayout" name="horizontalLayoutCalibDataButtons">
               <item>
                <spacer name="horizontalSpacerCalibData">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0">
                  <size><width>40</width><height>20</height></size>
                 </property>
                </spacer>
               </item>
               <item>
                <widget class="QPushButton" name="btnClearCalibData">
                 <property name="text"><string>초기화</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="btnSaveCalibResult">
                 <property name="text"><string>결과 저장</string></property>
                </widget>
               </item>
              </layout>
             </item>

            </layout>
           </widget>
          </item>

         </layout>
        </widget>

       </widget>
      </item>

