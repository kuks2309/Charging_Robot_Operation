motion.speed=100

p0=joint(0, 0, 90, 90, 90, 0)
movep(p0)
t1=11000

p1=pose(640, 160, 80, -90, 0, -90)
p2=pose(640, -160, 80, -90, 0, -90)
p3=pose(960, -160, 400, -90, 0, -90)
p4=pose(960, 160, 400, -90, 0, -90)
p5=pose(800, 0, 240, -90, 0, -90)

for i=1, 30 do
    movel(p1)
    delay(t1)
    movel(p2)
    delay(t1)
    movel(p3)
    delay(t1)
    movel(p4)
    delay(t1)
    movel(p5)
    delay(t1)
end