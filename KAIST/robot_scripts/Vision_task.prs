-- NOTE: KAIST 레거시 스크립트. 현재 프로젝트는 Main_task.prs 사용
-- 2026-03-21: int16 부호 변환 -65537 → -65536 수정 (off-by-one 버그)
toolframe(1)
modserv = modbus_server()
modserv.write_register('task_number', var.i(1))
sim_mode=modserv.read_register('sim_mode')
move_count=0
while move_count < 10 do
    move_signal=modserv.read_register('task_done')
--    move_signal=2
    if move_signal == 1 then
        modserv.write_register('task_done', 0)
        x = modserv.read_register('x')
        y = modserv.read_register('y')
        z = modserv.read_register('z')
        Rx= modserv.read_register('Rx')
        Ry = modserv.read_register('Ry')
        Rz = modserv.read_register('Rz') 
        if  x>32767  then
            x= x-65536
        end
        if  y>32767  then
            y= y-65536
        end
        if  z>32767  then
            z = z-65536
        end
        if  Rx>32767  then
            Rx= Rx-65536
        end
        if Ry>32767  then
            Ry= Ry-65536
        end
        if  Rz>32767  then
            Rz = Rz-65536
        end
        toolframe(var.i(2))
        p1 = pose (x/10,y/10,z/10,Rx/10,Ry/10,Rz/10)
        movel(p1)
        move_count = move_count + 1
        modserv.write_register('task_number', var.i(1))
        toolframe(1)
    end
    if move_signal == 2 then
        if  sim_mode==1  then
            toolframe(2)
            if  var.i(1) < 3  then
                movel(var.p(8))
                movel(var.p(7))
                movel(var.p(6))
                break
            else
                movel(var.p(12))
                movel(var.p(11))
                movel(var.p(10))
                break
            end
        else
            modserv.write_register('task_done', 0)
            x2 = modserv.read_register('x2')
            y2 = modserv.read_register('y2')
            z2 = modserv.read_register('z2')
            Rx2= modserv.read_register('Rx2')
            Ry2 = modserv.read_register('Ry2')
            Rz2 = modserv.read_register('Rz2') 
            if  x2>32767  then
                x2= x2-65536
            end
            if  y2>32767  then
                y2= y2-65536
            end
            if  z2>32767  then
                z2 = z2-65536
            end
            if  Rx2>32767  then
                Rx2= Rx2-65536
            end
            if Ry2>32767  then
                Ry2= Ry2-65536
            end
            if  Rz2>32767  then
                Rz2 = Rz2-65536
            end
            toolframe(var.i(2))        
            p2 = pose (x2/10,y2/10,z2/10,Rx2/10,Ry2/10,Rz2/10)
            movel(p2)
            tool.transz(30)
            break
        end
    end    
end
if move_count >= 10 then
    msg.warn("robot moved 10times")
    move_count=0
else
    if (var.i(3) == 1) then
        call('Gripper_grip')
    elseif (var.i(3) == 2) then
        call('Gripper_ungrip')
    end
    if  sim_mode==1  then
        if  var.i(1) < 3  then
            toolframe(2)
            movel(var.p(7))
            movel(var.p(8))
        else
            toolframe(2)
            movel(var.p(11))
            movel(var.p(12))
        end
    else
        tool.transz(-30)
    end
    delay(800)
end
